{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx-travel/itinerary",
    "title": "Tour Itinerary",
    "category": "jankx",
    "icon": "list-view",
    "description": "Hiển thị lịch trình tour theo từng ngày dạng accordion.",
    "textdomain": "jankx",
    "usesContext": ["postId", "postType"],
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "openFirstByDefault": {
            "type": "boolean",
            "default": true
        }
    },
    "render": "file:./render.php"
}
