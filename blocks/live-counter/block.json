{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jankx/live-counter",
	"title": "Live Counter",
	"category": "jankx",
	"icon": "performance",
	"description": "Hiển thị bộ đếm thời gian thực (số người đang xem, số lượt truy cập...).",
	"textdomain": "jankx",
	"attributes": {
		"counterType": {
			"type": "string",
			"default": "viewing",
			"enum": ["viewing", "visitors", "custom"]
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": "đang xem"
		},
		"min": {
			"type": "number",
			"default": 1
		},
		"max": {
			"type": "number",
			"default": 15
		},
		"interval": {
			"type": "number",
			"default": 3
		},
		"tagName": {
			"type": "string",
			"default": "span"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./build/index.tsx.js",
	"style": "file:./build/style.css",
	"editorStyle": "file:./build/editor.css"
}
